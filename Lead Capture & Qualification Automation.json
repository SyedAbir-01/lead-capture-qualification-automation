    {
      "parameters": {
        "jsCode": "const lead = $json;\n\nconst text = `${lead.message || \"\"} ${lead.company || \"\"}`.toLowerCase();\n\nlet score = 0;\n\nconst highIntentKeywords = [\n  \"need\",\n  \"urgent\",\n  \"ready\",\n  \"automation\",\n  \"automate\",\n  \"quote\",\n  \"pricing\",\n  \"price\",\n  \"project\",\n  \"hire\",\n  \"help\"\n];\n\nconst mediumIntentKeywords = [\n  \"interested\",\n  \"information\",\n  \"learn\",\n  \"details\",\n  \"demo\",\n  \"question\"\n];\n\nfor (const keyword of highIntentKeywords) {\n  if (text.includes(keyword)) {\n    score += 2;\n  }\n}\n\nfor (const keyword of mediumIntentKeywords) {\n  if (text.includes(keyword)) {\n    score += 1;\n  }\n}\n\nlet leadPriority;\nlet recommendedAction;\n\nif (score >= 4) {\n  leadPriority = \"HIGH\";\n  recommendedAction = \"Contact lead immediately\";\n} else if (score >= 1) {\n  leadPriority = \"MEDIUM\";\n  recommendedAction = \"Follow up within 24 hours\";\n} else {\n  leadPriority = \"LOW\";\n  recommendedAction = \"Add to nurture list\";\n}\n\nreturn [\n  {\n    json: {\n      ...lead,\n      leadScore: score,\n      leadPriority: leadPriority,\n      recommendedAction: recommendedAction\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
